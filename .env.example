# Copy to .env if you need overrides; defaults work for local runs.
DOCULENS_DATA_DIR=artifacts          # SQLite DB + FAISS index location (gitignored)
DOCULENS_EMBEDDER=fastembed          # fastembed (MiniLM, production) | tfidf (tests only)
DOCULENS_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
DOCULENS_GENERATOR=auto              # auto (try flan-t5-small, else extractive) | extractive | t5
DOCULENS_T5_MODEL=google/flan-t5-small
DOCULENS_MAX_UPLOAD_MB=5
DOCULENS_API=http://localhost:8100   # used by UI, ingest and evaluation scripts
